# Copy to .env and fill in, or run `npm run setup` to generate testnet accounts automatically.
# NEVER commit .env. Testnet keys only — never put a mainnet key here.
AGENT_ACCOUNT_ID=
AGENT_FULL_PRIVATE_KEY=
AGENT_FUNCTION_CALL_PRIVATE_KEY=
AGENT_FUNCTION_CALL_PUBLIC_KEY=
VENDOR_ACCOUNT_ID=
VENDOR_PRIVATE_KEY=
SCOPED_CONTRACT_ID=guestbook.near-examples.testnet
SCOPED_METHODS=add_message
FC_ALLOWANCE_NEAR=0.1
NEAR_RPC_URL=https://rpc.testnet.near.org
NEARBLOCKS_BASE_URL=https://api-testnet.nearblocks.io
